                            <i className="fa-solid fa-users text-indigo-600 mr-1.5"></i> Integrantes ({activeGroup.members.length})
                        </h3>
                        <div className="flex flex-wrap gap-1.5">
                            {activeGroup.members.map((member, index) => (
                                <span key={index} className="text-xs bg-gray-100 text-gray-700 px-2.5 py-1 rounded-full font-medium">
                                    {member}
                                </span>
                            ))}
                        </div>
                    </div>
                </div>
            );
