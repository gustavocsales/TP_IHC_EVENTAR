                const parsedMembers = membersInput
                    .split(',')
                    .map(m => m.trim())
                    .filter(Boolean);

                if (parsedMembers.length === 0) {
                    showToast('Informe ao menos um membro para o grupo!', 'error');
                    return;
                }

                const allMembers = parsedMembers.includes('Você') ? parsedMembers : ['Você', ...parsedMembers];

                const newGroup = {
                    id: Date.now(),
                    name: groupName.trim(),
                    members: allMembers,
                    events: [],
                    notices: []
                };

                setData({
                    ...data,
                    groups: [...data.groups, newGroup]
