                        <div className="flex gap-3 pt-2">
                            <button onClick={() => navigate('C6')} className="flex-1 bg-gray-200 text-gray-700 font-bold py-3 rounded-lg hover:bg-gray-300 transition">
                                Voltar
                            </button>
                            <button onClick={handleCreate} className="flex-1 bg-green-600 text-white font-bold py-3 rounded-lg hover:bg-green-700 transition">
                                Seguir
                            </button>
                        </div>
                    </div>
                </div>
            );
        };

        // --- CENA C9: VER ENQUETES ---
        const ScenePolls = () => (
            <div className="p-4">
                <div className="flex items-center mb-6">
                    <button onClick={() => navigate('C2')} className="mr-3 text-gray-500 hover:text-gray-800">
                        <i className="fa-solid fa-arrow-left"></i>
                    </button>
                    <h2 className="text-2xl font-bold text-gray-800">Enquetes</h2>
                </div>

                <div className="space-y-3">
                    {data.polls.map(poll => (
                        <div
                            key={poll.id}
                            onClick={() => navigate('C10', { poll })}
                            className="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex justify-between items-center cursor-pointer hover:bg-gray-50"
                        >
                            <div>
                                <h4 className="font-bold text-gray-800">{poll.name}</h4>
                                <p className="text-xs text-gray-500">{poll.group} • {poll.options?.length || 0} opções</p>
                                <p className="text-[11px] text-indigo-600 font-medium mt-1">
                                    <i className="fa-regular fa-clock mr-1"></i>{formatPollPeriod(poll)}
                                </p>
                            </div>
                            <span className={`text-xs px-2.5 py-1 rounded-full font-bold shrink-0 ${poll.status === 'Aberta' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'}`}>
                                {poll.status}
                            </span>
                        </div>
                    ))}
                </div>
            </div>
        );

        // --- CENA C10: ACESSAR ENQUETE ---
        const ScenePollDetails = () => {
            if (!activePoll) return null;

            const userCurrentVote = activePoll.options.find(opt => (opt.voters || []).includes(data.user.name));
            const [selectedOptionId, setSelectedOptionId] = useState(userCurrentVote ? userCurrentVote.id : null);
            const [showProposeBox, setShowProposeBox] = useState(false);
            const [proposeType, setProposeType] = useState('registered');
            const [selectedRegEventId, setSelectedRegEventId] = useState(data.events[0] ? data.events[0].id : '');

            // Campos para novo evento não registrado na proposta
            const [propName, setPropName] = useState('');
            const [propLocation, setPropLocation] = useState('');
            const [propDate, setPropDate] = useState('');
            const [propStartTime, setPropStartTime] = useState('');
            const [propEndTime, setPropEndTime] = useState('');
            const [propLink, setPropLink] = useState('');

            // Lista de participantes confirmados (votaram em qualquer opção que não seja Indisponível)
            const confirmedParticipants = Array.from(
                new Set(
                    activePoll.options
                        .filter(opt => !opt.isUnavailable)
                        .flatMap(opt => opt.voters || [])
                )
            );

            const handleVote = () => {
                if (!selectedOptionId) {
                    showToast('Selecione uma opção para votar!', 'error');
                    return;
                }

                const updatedPolls = data.polls.map(p => {
                    if (p.id !== activePoll.id) return p;
                    const updatedOptions = p.options.map(opt => {
                        const filteredVoters = (opt.voters || []).filter(v => v !== data.user.name);
                        if (opt.id === selectedOptionId) {
                            const nextVoters = [...filteredVoters, data.user.name];
                            return { ...opt, voters: nextVoters, votes: nextVoters.length };
                        }
                        return { ...opt, voters: filteredVoters, votes: filteredVoters.length };
                    });
                    return { ...p, options: updatedOptions };
                });

                setData({ ...data, polls: updatedPolls });
                showToast('Voto registrado com sucesso!', 'success');
                navigate('C11', { poll: activePoll });
            };

            const handleProposeOption = () => {
                let newOption = null;
                let updatedEventsList = [...data.events];

                if (proposeType === 'registered') {
                    const foundEv = data.events.find(e => String(e.id) === String(selectedRegEventId));
                    if (!foundEv) {
                        showToast('Selecione um evento registrado!', 'error');
                        return;
                    }
                    newOption = {
                        id: Date.now(),
                        text: foundEv.name,
                        eventName: foundEv.name,
                        location: foundEv.location,
                        date: foundEv.date || '',
                        startTime: foundEv.startTime || '',
                        endTime: foundEv.endTime || '',
                        votes: 0,
                        voters: []
                    };
                } else {
                    if (!propName.trim() || !propLocation.trim()) {
                        showToast('Preencha nome e localidade do evento proposto!', 'error');
                        return;
                    }
                    const createdEv = {
                        id: Date.now(),
                        name: propName.trim(),
                        location: propLocation.trim(),
                        date: propDate,
                        startTime: propStartTime,
                        endTime: propEndTime,
                        link: propLink.trim(),
                        dates: formatEventPeriod({ date: propDate, startTime: propStartTime, endTime: propEndTime })
                    };
                    updatedEventsList.push(createdEv);
                    newOption = {
                        id: Date.now() + 1,
                        text: createdEv.name,
                        eventName: createdEv.name,
                        location: createdEv.location,
                        date: createdEv.date,
                        startTime: createdEv.startTime,
                        endTime: createdEv.endTime,
                        votes: 0,
                        voters: []
                    };
                }

                const updatedPolls = data.polls.map(p => {
                    if (p.id !== activePoll.id) return p;
                    const unavailableIdx = p.options.findIndex(o => o.isUnavailable);
                    const nextOptions = [...p.options];
                    if (unavailableIdx >= 0) {
                        nextOptions.splice(unavailableIdx, 0, newOption);
                    } else {
                        nextOptions.push(newOption);
                    }
                    return { ...p, options: nextOptions };
                });

                setData({
                    ...data,
                    events: updatedEventsList,
                    polls: updatedPolls
                });

                setPropName('');
                setPropLocation('');
                setPropDate('');
                setPropStartTime('');
                setPropEndTime('');
                setPropLink('');
                setShowProposeBox(false);
                showToast('Nova opção adicionada à enquete!', 'success');
            };

            const handleConcludePoll = () => {
                // Apura opção vencedora com maior número de votos
                const sortedOptions = [...activePoll.options].sort((a, b) => (b.votes || 0) - (a.votes || 0));
                const winner = sortedOptions[0];

                const updatedPolls = data.polls.map(p =>
                    p.id === activePoll.id
                        ? { ...p, status: 'Encerrada', winnerOptionId: winner ? winner.id : null }
                        : p
                );

                // Se vencedor for "Indisponível" ou sem votos, não adiciona evento à agenda
                if (!winner || winner.isUnavailable) {
                    setData({ ...data, polls: updatedPolls });
                    showToast('Enquete encerrada sem evento vencedor (Indisponível).', 'info');
                    navigate('C9');
                    return;
                }

                const userVotedUnavailable = activePoll.options.some(
                    opt => opt.isUnavailable && (opt.voters || []).includes(data.user.name)
                );

                const confirmedForEvent = Array.from(
                    new Set(
                        activePoll.options
                            .filter(opt => !opt.isUnavailable)
                            .flatMap(opt => opt.voters || [])
                    )
                );

                // 1. Adiciona o evento vencedor na Agenda do Grupo (C6)
                const updatedGroups = data.groups.map(grp => {
                    if (grp.name !== activePoll.group) return grp;
                    const groupEvent = {
                        id: Date.now(),
                        title: winner.eventName || winner.text,
                        date: winner.date || '',
                        startTime: winner.startTime || '',
                        endTime: winner.endTime || '',
                        location: winner.location || '',
                        participants: confirmedForEvent
                    };
                    return {
                        ...grp,
                        events: [...(grp.events || []), groupEvent]
                    };
                });

                // 2. Verifica conflito e adiciona na Agenda Pessoal do usuário (C3) se não votou Indisponível
                let updatedSchedule = [...data.schedule];
                let updatedNotifications = [...data.notifications];

                if (!userVotedUnavailable) {
                    const conflict = hasScheduleConflict(updatedSchedule, winner);
                    if (conflict) {
                        updatedNotifications = [
                            {
                                id: Date.now() + 5,
                                type: 'conflict',
                                title: 'Conflito de horário detectado!',
                                message: `O evento "${winner.text}" (${formatEventPeriod(winner)}) conflita com "${conflict.title}" (${conflict.description}) e não foi marcado na sua agenda.`,
                                time: 'Agora',
                                unread: true
                            },
                            ...updatedNotifications
                        ];
                        showToast('Conflito de horário! Evento não marcado na sua agenda.', 'error');
                    } else {
                        const newScheduleItem = {
                            id: Date.now() + 2,
                            title: winner.eventName || winner.text,
                            group: activePoll.group,
                            date: winner.date || '',
                            startTime: winner.startTime || '',
                            endTime: winner.endTime || '',
                            description: formatScheduleDescription(winner),
                            location: winner.location || ''
                        };
                        updatedSchedule = [...updatedSchedule, newScheduleItem];
                        showToast(`Evento vencedor "${winner.text}" adicionado à agenda!`, 'success');
                    }
                } else {
                    showToast('Você marcou indisponível: evento adicionado apenas ao grupo.', 'info');
                }

                setData({
                    ...data,
                    polls: updatedPolls,
                    groups: updatedGroups,
                    schedule: updatedSchedule,
                    notifications: updatedNotifications
                });

                navigate('C9');
            };

            return (
                <div className="p-4">
                    <div className="flex items-center mb-4">
                        <button onClick={() => navigate('C9')} className="mr-3 text-gray-500 hover:text-gray-800">
                            <i className="fa-solid fa-arrow-left"></i>
                        </button>
                        <h2 className="text-xl font-bold text-gray-800 truncate">{activePoll.name}</h2>
                    </div>

                    <div className="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-4">
                        <div className="flex justify-between items-center mb-2">
                            <p className="text-sm text-gray-500">
                                Status: <strong className={activePoll.status === 'Aberta' ? 'text-green-600' : 'text-gray-600'}>{activePoll.status}</strong>
                            </p>
                            <span className="text-xs text-gray-500"><i className="fa-solid fa-users mr-1"></i>{activePoll.group}</span>
                        </div>

                        <div className="mb-3 px-2.5 py-1.5 bg-indigo-50 border border-indigo-100 rounded-lg text-xs text-indigo-800 flex items-center justify-between">
                            <span><i className="fa-regular fa-clock mr-1.5 text-indigo-600"></i><strong>Duração:</strong> {formatPollPeriod(activePoll)}</span>
                            <span className="text-[11px] font-semibold text-indigo-600">{getPollRemainingText(activePoll)}</span>
                        </div>

                        {/* Participantes Confirmados na Enquete */}
                        <div className="mb-4 p-3 bg-emerald-50 border border-emerald-200 rounded-lg">
                            <p className="text-xs font-bold text-emerald-900 mb-1.5">
                                <i className="fa-solid fa-user-check mr-1.5 text-emerald-600"></i>
                                Participantes Confirmados ({confirmedParticipants.length}):
                            </p>
                            {confirmedParticipants.length === 0 ? (
                                <p className="text-[11px] text-emerald-700">Nenhum participante confirmado ainda.</p>
                            ) : (
                                <div className="flex flex-wrap gap-1">
                                    {confirmedParticipants.map((person, idx) => (
                                        <span key={idx} className="text-[11px] bg-white text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded-full font-semibold">
                                            {person}
                                        </span>
                                    ))}
                                </div>
                            )}
                        </div>

                        {/* Opções de Voto */}
                        <div className="space-y-2.5">
                            {activePoll.options.map(opt => {
                                const isSelected = selectedOptionId === opt.id;
                                const isWinner = activePoll.status === 'Encerrada' && activePoll.winnerOptionId === opt.id;
                                return (
                                    <div
                                        key={opt.id}
                                        onClick={() => activePoll.status === 'Aberta' && setSelectedOptionId(opt.id)}
                                        className={`p-3 rounded-xl border transition ${
                                            activePoll.status === 'Aberta' ? 'cursor-pointer' : ''
                                        } ${
                                            isWinner
                                                ? 'bg-amber-50 border-amber-400'
                                                : opt.isUnavailable
                                                ? isSelected
                                                    ? 'bg-red-50 border-red-400'
                                                    : 'bg-gray-50 border-gray-200'
                                                : isSelected
                                                ? 'bg-indigo-50 border-indigo-500'
                                                : 'bg-white border-gray-200 hover:bg-gray-50'
                                        }`}
                                    >
                                        <div className="flex justify-between items-start">
                                            <div>
                                                <div className="flex items-center gap-1.5">
                                                    <span className={`text-sm font-bold ${opt.isUnavailable ? 'text-red-700' : 'text-gray-800'}`}>
                                                        {opt.text}
                                                    </span>
                                                    {isWinner && (
                                                        <span className="text-[10px] bg-amber-400 text-amber-950 font-extrabold px-2 py-0.5 rounded-full">
                                                            <i className="fa-solid fa-trophy mr-1"></i>Vencedor
                                                        </span>
                                                    )}
                                                </div>
                                                {!opt.isUnavailable && (
                                                    <p className="text-xs text-indigo-700 font-medium mt-0.5">
                                                        <i className="fa-regular fa-calendar mr-1"></i>
                                                        {formatEventPeriod(opt)} {opt.location ? `• ${opt.location}` : ''}
                                                    </p>
                                                )}
                                            </div>
                                            <span className="text-xs font-bold bg-gray-100 text-gray-700 px-2 py-0.5 rounded-full shrink-0">
                                                {opt.votes || 0} voto(s)
                                            </span>
                                        </div>

                                        {opt.voters && opt.voters.length > 0 && (
                                            <div className="mt-2 flex flex-wrap gap-1">
                                                {opt.voters.map((voter, idx) => (
                                                    <span key={idx} className="text-[10px] bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">
                                                        {voter}
                                                    </span>
                                                ))}
                                            </div>
                                        )}
                                    </div>
                                );
                            })}
                        </div>

                        {/* Propor outra opção */}
                        {activePoll.status === 'Aberta' && (
                            <div className="mt-4 pt-3 border-t border-gray-100">
                                <button
                                    type="button"
                                    onClick={() => setShowProposeBox(!showProposeBox)}
                                    className="w-full py-2 text-xs font-bold text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition"
                                >
                                    <i className="fa-solid fa-plus mr-1"></i>
                                    {showProposeBox ? 'Fechar proposta de opção' : 'Propor outra opção de evento'}
                                </button>

                                {showProposeBox && (
                                    <div className="mt-3 p-3 bg-gray-50 rounded-xl border border-gray-200 space-y-2.5">
                                        <div className="flex gap-2">
                                            <button
                                                type="button"
                                                onClick={() => setProposeType('registered')}
                                                className={`flex-1 py-1.5 text-xs font-bold rounded-lg ${proposeType === 'registered' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 border'}`}
                                            >
                                                Evento Registrado
                                            </button>
                                            <button
                                                type="button"
                                                onClick={() => setProposeType('new')}
                                                className={`flex-1 py-1.5 text-xs font-bold rounded-lg ${proposeType === 'new' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-600 border'}`}
                                            >
                                                Novo Evento
                                            </button>
                                        </div>

                                        {proposeType === 'registered' ? (
                                            <select
                                                value={selectedRegEventId}
                                                onChange={e => setSelectedRegEventId(e.target.value)}
                                                className="w-full p-2.5 border rounded-lg text-xs bg-white"
                                            >
                                                {data.events.map(ev => (
                                                    <option key={ev.id} value={ev.id}>
                                                        {ev.name} ({formatEventPeriod(ev)})
                                                    </option>
                                                ))}
                                            </select>
                                        ) : (
                                            <div className="space-y-2">
                                                <input
                                                    type="text"
                                                    value={propName}
                                                    onChange={e => setPropName(e.target.value)}
                                                    placeholder="Nome do evento *"
                                                    className="w-full p-2 border rounded-lg text-xs bg-white"
                                                />
                                                <input
                                                    type="text"
                                                    value={propLocation}
                                                    onChange={e => setPropLocation(e.target.value)}
                                                    placeholder="Localidade *"
                                                    className="w-full p-2 border rounded-lg text-xs bg-white"
                                                />
                                                <div className="grid grid-cols-2 gap-2">
                                                    <input type="date" value={propDate} onChange={e => setPropDate(e.target.value)} className="w-full p-2 border rounded-lg text-xs bg-white" />
                                                    <input type="time" value={propStartTime} onChange={e => setPropStartTime(e.target.value)} className="w-full p-2 border rounded-lg text-xs bg-white" />
                                                </div>
                                                <div className="grid grid-cols-2 gap-2">
                                                    <input type="time" value={propEndTime} onChange={e => setPropEndTime(e.target.value)} className="w-full p-2 border rounded-lg text-xs bg-white" />
                                                    <input type="url" value={propLink} onChange={e => setPropLink(e.target.value)} placeholder="Link (opcional)" className="w-full p-2 border rounded-lg text-xs bg-white" />
                                                </div>
                                            </div>
                                        )}

                                        <button
                                            type="button"
                                            onClick={handleProposeOption}
                                            className="w-full bg-indigo-600 text-white font-bold py-2 rounded-lg text-xs hover:bg-indigo-700"
                                        >
                                            Adicionar à Enquete
                                        </button>
                                    </div>
                                )}
                            </div>
                        )}
                    </div>

                    {activePoll.status === 'Aberta' ? (
                        <div className="space-y-2.5">
                            <button
                                onClick={handleVote}
                                className="w-full bg-indigo-600 text-white font-bold py-3 rounded-xl hover:bg-indigo-700 transition shadow-sm"
                            >
                                Confirmar Voto
                            </button>
                            <button
                                onClick={handleConcludePoll}
                                className="w-full bg-emerald-600 text-white font-bold py-3 rounded-xl hover:bg-emerald-700 transition shadow-sm"
                            >
                                Encerrar Votação e Consolidar Evento
                            </button>
                        </div>
                    ) : (
                        <button
                            onClick={() => navigate('C11', { poll: activePoll })}
                            className="w-full bg-gray-800 text-white font-bold py-3 rounded-xl hover:bg-gray-900 transition"
                        >
                            Ver Resumo da Votação
                        </button>
                    )}
                </div>
            );
        };

        // --- CENA C11: ACOMPANHAR VOTAÇÃO ---
        const ScenePollStatus = () => {
            if (!activePoll) return null;

            const totalVotes = activePoll.options.reduce((acc, opt) => acc + (opt.votes || 0), 0);

            const handleCancelVote = () => {
                const updatedPolls = data.polls.map(p => {
                    if (p.id !== activePoll.id) return p;
                    const updatedOptions = p.options.map(opt => {
                        const filtered = (opt.voters || []).filter(v => v !== data.user.name);
                        return { ...opt, voters: filtered, votes: filtered.length };
                    });
                    return { ...p, options: updatedOptions };
                });
                setData({ ...data, polls: updatedPolls });
                showToast('Voto cancelado!', 'info');
                navigate('C10');
            };

            return (
                <div className="p-4">
                    <div className="flex items-center mb-6">
                        <button onClick={() => navigate('C10')} className="mr-3 text-gray-500 hover:text-gray-800">
                            <i className="fa-solid fa-arrow-left"></i>
                        </button>
                        <h2 className="text-xl font-bold text-gray-800">Acompanhar Votação</h2>
                    </div>

                    <div className="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-4">
                        <h3 className="font-bold text-gray-900 mb-1">{activePoll.name}</h3>
                        <p className="text-xs text-gray-500 mb-4">{activePoll.group}</p>

                        <div className="space-y-3">
                            {activePoll.options.map(opt => {
                                const votes = opt.votes || 0;
                                const pct = totalVotes > 0 ? Math.round((votes / totalVotes) * 100) : 0;
                                return (
                                    <div key={opt.id}>
                                        <div className="flex justify-between text-xs font-bold mb-1">
                                            <span className={opt.isUnavailable ? 'text-red-600' : 'text-gray-800'}>
                                                {opt.text} {!opt.isUnavailable && opt.date ? `(${formatDateBR(opt.date)})` : ''}
                                            </span>
                                            <span className="text-indigo-600">{votes} ({pct}%)</span>
                                        </div>
                                        <div className="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden">
                                            <div
                                                className={`h-full rounded-full ${opt.isUnavailable ? 'bg-red-400' : 'bg-indigo-600'}`}
                                                style={{ width: `${pct}%` }}
                                            ></div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>

                        <div className="border-t pt-4 text-xs text-gray-600 space-y-1.5 mt-4">
                            <div className="flex justify-between">
                                <span><i className="fa-solid fa-check-to-slot mr-1 text-indigo-500"></i> Total de votos: <strong>{totalVotes}</strong></span>
                                <span className="text-orange-600 font-bold">{getPollRemainingText(activePoll)}</span>
                            </div>
                            <div className="flex justify-between text-gray-500">
                                <span><i className="fa-regular fa-calendar-plus mr-1"></i> Criada em: {activePoll.createdAt || 'Hoje'}</span>
                                <span><i className="fa-regular fa-clock mr-1"></i> {formatPollPeriod(activePoll)}</span>
                            </div>
                        </div>
                    </div>

                    {activePoll.status === 'Aberta' && (
                        <button
                            onClick={handleCancelVote}
                            className="w-full bg-red-100 text-red-600 font-bold py-3 rounded-lg hover:bg-red-200 transition mb-2.5"
                        >
                            Cancelar Votação
                        </button>
                    )}

                    <button
                        onClick={() => navigate('C10')}
                        className="w-full bg-gray-200 text-gray-700 font-bold py-3 rounded-lg hover:bg-gray-300 transition"
                    >
                        Voltar para a enquete
                    </button>
                </div>
            );
        };

        // --- CENA C12: VER EVENTOS ---
        const SceneEvents = () => (
            <div className="p-4">
                <div className="flex items-center mb-6">
                    <button onClick={() => navigate('C2')} className="mr-3 text-gray-500 hover:text-gray-800">
                        <i className="fa-solid fa-arrow-left"></i>
                    </button>
                    <h2 className="text-2xl font-bold text-gray-800">Eventos e Locais</h2>
                </div>

                <div className="space-y-4 mb-6">
                    {data.events.map(ev => (
                        <div key={ev.id} className="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
                            <h4 className="font-bold text-lg text-indigo-700 mb-1">{ev.name}</h4>
                            <p className="text-sm text-gray-600 mb-1"><i className="fa-solid fa-location-dot mr-2 w-4"></i>{ev.location}</p>
                            
                            {/* Período destrinchado para comparação */}
                            <div className="bg-indigo-50 border border-indigo-100 rounded-lg p-2.5 my-2 text-xs space-y-1">
                                <div className="flex items-center text-indigo-900 font-semibold">
                                    <i className="fa-solid fa-calendar-day mr-2 text-indigo-600"></i>
                                    <span>Data: {ev.date ? formatDateBR(ev.date) : 'A definir'}</span>
                                </div>
                                {ev.startTime && (
                                    <div className="flex items-center text-indigo-800">
                                        <i className="fa-regular fa-clock mr-2 text-indigo-500"></i>
                                        <span>Horário início: {ev.startTime} {ev.endTime ? `| Término: ${ev.endTime}` : ''}</span>
                                    </div>
                                )}
                            </div>

                            {ev.link && (
                                <a href={ev.link} target="_blank" rel="noopener noreferrer" className="text-sm text-blue-500 underline mt-1 inline-block">
                                    <i className="fa-solid fa-link mr-1"></i>Ver Link
                                </a>
                            )}
                        </div>
                    ))}
                </div>

                <button onClick={() => navigate('C13')} className="w-full bg-indigo-600 text-white font-bold py-3 rounded-xl hover:bg-indigo-700 transition">
                    <i className="fa-solid fa-plus mr-2"></i> Adicionar Evento
                </button>
            </div>
        );

        // --- CENA C13: ADICIONAR EVENTO ---
        const SceneAddEvent = () => {
            const [name, setName] = useState('');
            const [date, setDate] = useState('');
            const [startTime, setStartTime] = useState('');
            const [endTime, setEndTime] = useState('');
            const [link, setLink] = useState('');
            const [location, setLocation] = useState('');

            const handleSave = () => {
                if (!name.trim() || !location.trim()) {
                    showToast('Preencha os campos obrigatórios (Nome do evento e Localidade)!', 'error');
                    return;
                }
                const formattedDates = formatEventPeriod({ date, startTime, endTime });
                const newEvent = {
                    id: Date.now(),
                    name: name.trim(),
                    date,
                    startTime,
                    endTime,
                    dates: formattedDates,
                    link: link.trim(),
                    location: location.trim()
                };
                setData({ ...data, events: [...data.events, newEvent] });
                
                showToast('Evento registrado com sucesso!', 'success');
                navigate('C12');
            };

            return (
                <div className="p-4">
                    <div className="flex items-center mb-6">
                        <button onClick={() => navigate('C12')} className="mr-3 text-gray-500 hover:text-gray-800">
                            <i className="fa-solid fa-arrow-left"></i>
                        </button>
                        <h2 className="text-2xl font-bold text-gray-800">Adicionar Evento</h2>
                    </div>

                    <div className="space-y-3">
                        <div>
                            <label className="block text-sm font-semibold text-gray-700 mb-1">Nome do evento:*</label>
                            <input type="text" value={name} onChange={e => setName(e.target.value)} className="w-full p-3 border rounded-lg" placeholder="Ex: Sítio Bela Vista" />
                        </div>

                        <div>
                            <label className="block text-sm font-semibold text-gray-700 mb-1">Localidade:*</label>
                            <input type="text" value={location} onChange={e => setLocation(e.target.value)} className="w-full p-3 border rounded-lg" placeholder="Endereço ou Região" />
                        </div>
                        
                        <div className="grid grid-cols-2 gap-2">
                            <div>
                                <label className="block text-sm font-semibold text-gray-700 mb-1">Data (opcional):</label>
                                <input type="date" value={date} onChange={e => setDate(e.target.value)} className="w-full p-2.5 border rounded-lg text-sm bg-white" />
                            </div>
                            <div>
                                <label className="block text-sm font-semibold text-gray-700 mb-1">Horário início (opcional):</label>
                                <input type="time" value={startTime} onChange={e => setStartTime(e.target.value)} className="w-full p-2.5 border rounded-lg text-sm bg-white" />
                            </div>
                        </div>

                        <div>
                            <label className="block text-sm font-semibold text-gray-700 mb-1">Horário término (opcional):</label>
                            <input type="time" value={endTime} onChange={e => setEndTime(e.target.value)} className="w-full p-2.5 border rounded-lg text-sm bg-white" />
                        </div>

                        <div>
                            <label className="block text-sm font-semibold text-gray-700 mb-1">Link (opcional):</label>
                            <input type="url" value={link} onChange={e => setLink(e.target.value)} className="w-full p-3 border rounded-lg" placeholder="https://" />
                        </div>
                    </div>

                    <div className="mt-6 flex gap-3">
                        <button onClick={() => navigate('C12')} className="flex-1 bg-gray-200 text-gray-700 font-bold py-3 rounded-lg hover:bg-gray-300 transition">
                            Cancelar
                        </button>
                        <button onClick={handleSave} className="flex-1 bg-green-600 text-white font-bold py-3 rounded-lg hover:bg-green-700 transition">
                            Salvar
                        </button>
                    </div>
                </div>
            );
        };

        // --- NAVEGAÇÃO UBÍQUA ---
        const bottomNavItems = [
            { scene: 'C2', icon: 'fa-house', label: 'Início' },
            { scene: 'C3', icon: 'fa-calendar-days', label: 'Agenda' },
            { scene: 'C4', icon: 'fa-users', label: 'Grupos' },
            { scene: 'C9', icon: 'fa-square-poll-vertical', label: 'Enquetes' },
            { scene: 'C1', icon: 'fa-right-from-bracket', label: 'Sair' }
        ];

        // --- RENDERIZADOR PRINCIPAL ---
        const renderScene = () => {
            switch (currentScene) {
                case 'C1': return <SceneLogin />;
                case 'C2': return <SceneHome />;
                case 'C3': return <SceneSchedule />;
                case 'C4': return <SceneGroups />;
                case 'C5': return <SceneCreateGroup />;
                case 'C6': return <SceneGroupInfo />;
                case 'C7': return <SceneNotifications />;
                case 'C8': return <SceneCreatePoll />;
                case 'C9': return <ScenePolls />;
                case 'C10': return <ScenePollDetails />;
                case 'C11': return <ScenePollStatus />;
                case 'C12': return <SceneEvents />;
                case 'C13': return <SceneAddEvent />;
                default: return <SceneHome />;
            }
        };

        const showBottomNav = currentScene !== 'C1';

        return (
            <div className="app-container">
                {/* Status Bar */}
                <div className="h-6 shrink-0 bg-gray-900 w-full flex justify-between items-center px-4 text-xs text-white">
                    <span>9:41</span>
                    <div className="flex space-x-1">
                        <i className="fa-solid fa-signal"></i>
                        <i className="fa-solid fa-wifi"></i>
                        <i className="fa-solid fa-battery-full"></i>
                    </div>
                </div>

                {/* Área Scrollável */}
                <div className="scrollable-content bg-gray-50 relative">
                    {/* Mensagem Toast */}
                    {toast && (
                        <div className={`sticky top-3 mx-4 mt-3 ${toast.type === 'error' ? 'bg-red-600' : 'bg-gray-800'} text-white text-xs font-semibold p-3 rounded-xl shadow-xl z-50 flex items-center justify-between`}>
                            <span className="pr-2">{toast.message}</span>
                            <button onClick={() => setToast(null)} className="text-white/80 hover:text-white shrink-0">
                                <i className="fa-solid fa-times"></i>
                            </button>
                        </div>
                    )}
                    
                    {/* Renderização da Cena Ativa */}
                    {renderScene()}
                </div>

                {/* Navegação Ubíqua */}
                {showBottomNav && (
                    <div className="absolute bottom-0 w-full bg-white border-t border-gray-200 flex justify-around pb-4 pt-2 px-2 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)]">
                        {bottomNavItems.map(item => (
                            <div 
                                key={item.scene}
                                onClick={() => navigate(item.scene)}
                                className={`flex flex-col items-center justify-center w-16 cursor-pointer transition-colors ${currentScene === item.scene ? 'text-indigo-600' : 'text-gray-400 hover:text-indigo-400'}`}
                            >
                                <i className={`fa-solid ${item.icon} text-xl mb-1`}></i>
                                <span className="text-[10px] font-semibold">{item.label}</span>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        );
    };

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
</script>

</body>
</html>
