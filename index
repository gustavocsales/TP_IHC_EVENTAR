                                        n.type === 'conflict'
                                            ? 'bg-red-50 border-red-200'
                                            : n.unread
                                            ? 'bg-indigo-50/60 border-indigo-200'
                                            : 'bg-white border-gray-100'
                                    }`}
                                >
                                    <div className="flex justify-between items-start mb-1">
                                        <h4 className={`text-sm font-bold ${n.type === 'conflict' ? 'text-red-800' : 'text-gray-800'}`}>
                                            {n.type === 'conflict' && <i className="fa-solid fa-triangle-exclamation mr-1.5 text-red-600"></i>}
                                            {n.title}
                                        </h4>
                                        <span className="text-[10px] text-gray-400 shrink-0 ml-2">{n.time}</span>
                                    </div>
                                    <p className={`text-xs ${n.type === 'conflict' ? 'text-red-700' : 'text-gray-600'}`}>{n.message}</p>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
            );
        };

        // --- CENA C8: CRIAR ENQUETE ---
        const SceneCreatePoll = () => {
            const [pollName, setPollName] = useState('');
            const [selectedGroup, setSelectedGroup] = useState(activeGroup ? activeGroup.name : (data.groups[0] ? data.groups[0].name : ''));
            const [pollEndDate, setPollEndDate] = useState('');
            const [pollEndTime, setPollEndTime] = useState('');
            const [selectedEventIds, setSelectedEventIds] = useState([]);

            // Formulário expansível para novo evento (não registrado)
            const [showNewEventForm, setShowNewEventForm] = useState(false);
            const [newEvName, setNewEvName] = useState('');
            const [newEvLocation, setNewEvLocation] = useState('');
            const [newEvDate, setNewEvDate] = useState('');
            const [newEvStartTime, setNewEvStartTime] = useState('');
            const [newEvEndTime, setNewEvEndTime] = useState('');
            const [newEvLink, setNewEvLink] = useState('');
            const [customDraftEvents, setCustomDraftEvents] = useState([]);

            const toggleEventSelection = (id) => {
                setSelectedEventIds(prev =>
                    prev.includes(id) ? prev.filter(item => item !== id) : [...prev, id]
                );
            };

            const handleAddDraftEvent = () => {
                if (!newEvName.trim() || !newEvLocation.trim()) {
                    showToast('Informe o nome e a localidade do novo evento!', 'error');
                    return;
                }
                const draft = {
                    id: Date.now(),
                    name: newEvName.trim(),
                    location: newEvLocation.trim(),
                    date: newEvDate,
                    startTime: newEvStartTime,
                    endTime: newEvEndTime,
                    link: newEvLink.trim(),
                    dates: formatEventPeriod({ date: newEvDate, startTime: newEvStartTime, endTime: newEvEndTime })
                };
                setCustomDraftEvents([...customDraftEvents, draft]);
                setNewEvName('');
                setNewEvLocation('');
                setNewEvDate('');
                setNewEvStartTime('');
                setNewEvEndTime('');
                setNewEvLink('');
                setShowNewEventForm(false);
                showToast('Novo evento adicionado à enquete!', 'success');
            };

            const handleCreate = () => {
                if (!pollName.trim()) {
                    showToast('Informe o título da enquete!', 'error');
                    return;
                }

                const chosenRegistered = data.events.filter(ev => selectedEventIds.includes(ev.id));
                const combinedEvents = [...chosenRegistered, ...customDraftEvents];

                const options = combinedEvents.map((ev, idx) => ({
                    id: Date.now() + idx + 1,
                    text: ev.name,
                    eventName: ev.name,
                    location: ev.location,
                    date: ev.date || '',
                    startTime: ev.startTime || '',
                    endTime: ev.endTime || '',
                    votes: 0,
                    voters: []
                }));

                // Sempre adiciona a opção "Indisponível"
                options.push({
                    id: Date.now() + 999,
                    text: 'Indisponível',
                    isUnavailable: true,
                    votes: 0,
                    voters: []
                });

                if (options.length <= 1) {
                    showToast('Selecione ou adicione ao menos um evento além de indisponível!', 'error');
                    return;
                }

                // Validação MoLIC: verificar inconsistência de horário entre encerramento da enquete e data dos eventos
                if (pollEndDate) {
                    const inconsistentEvent = options.find(opt => opt.date && pollEndDate > opt.date);
                    if (inconsistentEvent) {
                        showToast(`Inconsistência de horário: o encerramento da enquete (${formatDateBR(pollEndDate)}) não pode ser após o evento "${inconsistentEvent.text}" (${formatDateBR(inconsistentEvent.date)}).`, 'error');
                        return;
                    }
                }

                const now = new Date();
                const createdAt = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()} às ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

                const newPoll = {
                    id: Date.now(),
                    name: pollName.trim(),
                    status: 'Aberta',
                    group: selectedGroup,
                    endDate: pollEndDate,
                    endTime: pollEndDate ? (pollEndTime || '23:59') : pollEndTime,
                    createdAt,
                    options
                };

                const updatedEvents = [...data.events, ...customDraftEvents];

                setData({
                    ...data,
                    events: updatedEvents,
                    polls: [newPoll, ...data.polls]
                });

                showToast('Enquete criada com sucesso!', 'success');
                navigate('C9');
            };

            return (
                <div className="p-4">
                    <div className="flex items-center mb-6">
                        <button onClick={() => navigate('C6')} className="mr-3 text-gray-500 hover:text-gray-800">
                            <i className="fa-solid fa-arrow-left"></i>
                        </button>
                        <h2 className="text-2xl font-bold text-gray-800">Criar Enquete</h2>
                    </div>

                    <div className="space-y-4">
                        <div>
                            <label className="block text-sm font-semibold text-gray-700 mb-1">Título da Enquete:</label>
                            <input
                                type="text"
                                value={pollName}
                                onChange={e => setPollName(e.target.value)}
                                className="w-full p-3 border rounded-lg bg-white"
                                placeholder="Ex: Confraternização de Fim de Ano"
                            />
                        </div>

                        <div>
                            <label className="block text-sm font-semibold text-gray-700 mb-1">Grupo Destino:</label>
                            <select value={selectedGroup} onChange={e => setSelectedGroup(e.target.value)} className="w-full p-3 border rounded-lg bg-white">
                                {data.groups.map(g => <option key={g.id} value={g.name}>{g.name}</option>)}
                            </select>
                        </div>

                        {/* Período de Duração da Enquete (Data e Horário) */}
                        <div className="p-3.5 bg-indigo-50/70 border border-indigo-100 rounded-xl">
                            <label className="block text-sm font-bold text-indigo-950 mb-1">
                                <i className="fa-regular fa-clock text-indigo-600 mr-1.5"></i>
                                Período de Duração da Enquete:
                            </label>
                            <p className="text-xs text-gray-600 mb-2.5">Defina a data e o horário limite para votação.</p>
                            <div className="grid grid-cols-2 gap-2.5">
                                <div>
                                    <label className="block text-xs font-semibold text-gray-700 mb-1">Data de encerramento:</label>
                                    <input
                                        type="date"
                                        value={pollEndDate}
                                        onChange={e => setPollEndDate(e.target.value)}
                                        className="w-full p-2.5 border rounded-lg text-xs bg-white"
                                    />
                                </div>
                                <div>
                                    <label className="block text-xs font-semibold text-gray-700 mb-1">Horário limite:</label>
                                    <input
                                        type="time"
                                        value={pollEndTime}
                                        onChange={e => setPollEndTime(e.target.value)}
                                        className="w-full p-2.5 border rounded-lg text-xs bg-white"
                                    />
                                </div>
                            </div>
                        </div>

                        <div>
                            <label className="block text-sm font-semibold text-gray-700 mb-2">Escolher Eventos Registrados:</label>
                            <div className="space-y-2">
                                {data.events.map(ev => {
                                    const checked = selectedEventIds.includes(ev.id);
                                    return (
                                        <div
                                            key={ev.id}
                                            onClick={() => toggleEventSelection(ev.id)}
                                            className={`p-3 rounded-xl border cursor-pointer flex items-center justify-between transition ${checked ? 'bg-indigo-50 border-indigo-400' : 'bg-white border-gray-200'}`}
                                        >
                                            <div>
                                                <p className="text-sm font-bold text-gray-800">{ev.name}</p>
                                                <p className="text-xs text-gray-500">{ev.location} • {formatEventPeriod(ev)}</p>
                                            </div>
                                            <div className={`w-5 h-5 rounded flex items-center justify-center border ${checked ? 'bg-indigo-600 border-indigo-600 text-white' : 'border-gray-300'}`}>
                                                {checked && <i className="fa-solid fa-check text-xs"></i>}
                                            </div>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>

                        {/* Novos eventos adicionados nesta enquete */}
                        {customDraftEvents.length > 0 && (
                            <div className="space-y-2">
                                <label className="block text-xs font-bold text-emerald-700 uppercase">Novos Eventos Adicionados:</label>
                                {customDraftEvents.map(ev => (
                                    <div key={ev.id} className="p-2.5 bg-emerald-50 border border-emerald-200 rounded-lg flex justify-between items-center">
                                        <div>
                                            <p className="text-xs font-bold text-emerald-900">{ev.name}</p>
                                            <p className="text-[11px] text-emerald-700">{ev.location} • {formatEventPeriod(ev)}</p>
                                        </div>
                                        <button
                                            type="button"
                                            onClick={() => setCustomDraftEvents(customDraftEvents.filter(item => item.id !== ev.id))}
                                            className="text-red-500 text-xs px-2"
                                        >
                                            <i className="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                ))}
                            </div>
                        )}

                        {/* Botão expansível para novo evento (não registrado) */}
                        <div>
                            <button
                                type="button"
                                onClick={() => setShowNewEventForm(!showNewEventForm)}
                                className="w-full py-2.5 px-3 border-2 border-dashed border-indigo-300 text-indigo-600 font-semibold text-xs rounded-xl hover:bg-indigo-50 transition"
                            >
                                <i className={`fa-solid ${showNewEventForm ? 'fa-chevron-up' : 'fa-plus'} mr-1.5`}></i>
