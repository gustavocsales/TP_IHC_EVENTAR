    const formatDateBR = (isoDate) => {
        if (!isoDate) return '';
        if (isoDate.includes('/')) return isoDate;
        const parts = isoDate.split('-');
        if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
        return isoDate;
    };

    const formatEventPeriod = (ev) => {
        if (!ev) return 'Data a definir';
        const dateStr = ev.date ? formatDateBR(ev.date) : '';
        const timeStr = ev.startTime 
            ? `${ev.startTime}${ev.endTime ? ` às ${ev.endTime}` : ''}`
            : '';
        if (dateStr && timeStr) return `${dateStr} • ${timeStr}`;
        if (dateStr) return dateStr;
        if (timeStr) return timeStr;
        return 'Data a definir';
    };

    const formatScheduleDescription = (ev) => {
        const dateStr = ev.date ? formatDateBR(ev.date) : 'Data a definir';
        const timeStr = ev.startTime
            ? `${ev.startTime}${ev.endTime ? ` às ${ev.endTime}` : ''}`
            : 'Horário a definir';
        return `${dateStr} - ${timeStr}`;
    };

    const formatPollPeriod = (poll) => {
        if (!poll || !poll.endDate) return 'Prazo não definido';
        const dateStr = formatDateBR(poll.endDate);
        const timeStr = poll.endTime ? ` às ${poll.endTime}` : '';
        return `Até ${dateStr}${timeStr}`;
    };

    const getPollRemainingText = (poll) => {
        if (!poll || poll.status === 'Encerrada') return 'Encerrada';
        if (!poll.endDate) return 'Sem limite';
        const target = new Date(`${poll.endDate}T${poll.endTime || '23:59'}:00`);
        const now = new Date();
        const diffMs = target - now;
        if (isNaN(target.getTime())) return formatPollPeriod(poll);
        if (diffMs <= 0) return 'Prazo expirado';
        const totalHours = Math.floor(diffMs / (1000 * 60 * 60));
        const days = Math.floor(totalHours / 24);
        const hours = totalHours % 24;
        const mins = Math.floor((diffMs / (1000 * 60)) % 60);
        if (days > 0) return `${days}d ${hours}h restantes`;
        if (hours > 0) return `${hours}h ${mins}min restantes`;
        return `${mins}min restantes`;
    };

    const timeToMinutes = (timeStr) => {
        if (!timeStr) return null;
        const [h, m] = timeStr.split(':').map(Number);
        if (isNaN(h) || isNaN(m)) return null;
        return h * 60 + m;
    };

    const hasScheduleConflict = (scheduleList, candidateEvent) => {
        if (!candidateEvent || !candidateEvent.date) return null;
        return scheduleList.find(item => {
            if (item.date !== candidateEvent.date) return false;
            const itemStart = timeToMinutes(item.startTime);
            const itemEnd = timeToMinutes(item.endTime) ?? (itemStart !== null ? itemStart + 60 : null);
            const candStart = timeToMinutes(candidateEvent.startTime);
            const candEnd = timeToMinutes(candidateEvent.endTime) ?? (candStart !== null ? candStart + 60 : null);

            if (itemStart === null || candStart === null) return true;
            return candStart < itemEnd && candEnd > itemStart;
        }) || null;
    };

