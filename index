                                            <div className="mt-1.5 flex flex-wrap gap-1">
                                                {ev.participants.map((p, idx) => (
                                                    <span key={idx} className="text-[10px] bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-semibold">
