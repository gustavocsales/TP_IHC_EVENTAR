                                            <input type="time" value={newEvEndTime} onChange={e => setNewEvEndTime(e.target.value)} className="w-full p-2 border rounded-lg text-xs bg-white" />
                                        </div>
                                        <div>
                                            <label className="block text-[11px] text-gray-500 mb-0.5">Link (opcional)</label>
                                            <input type="url" value={newEvLink} onChange={e => setNewEvLink(e.target.value)} placeholder="https://" className="w-full p-2 border rounded-lg text-xs bg-white" />
                                        </div>
