        // --- CENA C7: VER NOTIFICAÇÕES ---
        const SceneNotifications = () => {
            const handleOpenNotification = (notif) => {
                const updatedNotifs = data.notifications.map(n =>
                    n.id === notif.id ? { ...n, unread: false } : n
                );
                setData({ ...data, notifications: updatedNotifs });

                if (notif.pollId) {
                    const targetPoll = data.polls.find(p => p.id === notif.pollId);
                    if (targetPoll) {
                        navigate('C10', { poll: targetPoll });
                        return;
                    }
                }
                if (notif.type === 'conflict' || notif.type === 'reminder' || notif.type === 'cancel') {
                    navigate('C3');
                }
            };

            return (
                <div className="p-4">
                    <div className="flex items-center mb-6">
